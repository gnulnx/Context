#!/usr/bin/env python3
"""Record real Codex recall with disposable history and the installed integration.

Run with the Python environment containing bl_context, e.g.:
    .venv/bin/python assets/make-recall-gif
"""

import json
import os
import shlex
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

from bl_context import codex_hooks, codex_skills, embedding, mcp_registration, storage


def tmux(socket, *args):
    subprocess.run(["tmux", "-L", socket, *args], check=True)


def main():
    repo = Path(__file__).resolve().parent.parent
    for command in ("codex", "tmux", "vhs", "ffmpeg"):
        if not shutil.which(command):
            raise SystemExit(f"error: {command} is required")

    original_paths = storage.locations()
    original_codex = codex_skills.root()
    auth = original_codex / "auth.json"
    if not auth.is_file():
        raise SystemExit("error: sign in with `codex login` before recording")
    config = mcp_registration.config(original_codex)
    model = config.get("model", "gpt-6-astra")

    # Codex refuses helper binaries under /tmp. Keep its disposable home in
    # the user cache, with private permissions and no personal session history.
    cache = Path.home() / ".cache"
    cache.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="recall-", dir=cache) as temporary:
        root = Path(temporary)
        project = root / "demo"
        project.mkdir()
        shell_rc = root / "shell.rc"
        shell_rc.write_text("PS1='> '\n")
        shell = shlex.join(["bash", "--noprofile", "--rcfile", str(shell_rc)])
        codex = root / "codex"
        codex.mkdir(mode=0o700)
        shutil.copyfile(auth, codex / "auth.json")
        (codex / "auth.json").chmod(0o600)
        (codex / "config.toml").write_text(
            f'model = {json.dumps(model)}\n'
            'model_reasoning_effort = "low"\n'
            'check_for_update_on_startup = false\n'
            'web_search = "disabled"\n'
            'personality = "none"\n'
            '[features]\napps = false\nmemories = false\nplugins = false\n'
            '[tui]\nshow_tooltips = false\nstatus_line = []\n'
        )
        os.environ["CODEX_HOME"] = str(codex)
        for kind in original_paths:
            os.environ[f"BLCTX_{kind.upper()}_DIR"] = str(root / kind)
        storage.install()
        paths = storage.locations()

        # Reuse only verified model weights. No answers or transcripts are seeded.
        storage.prepare_index_artifacts(paths, "embeddings")
        shutil.copytree(embedding.directory(original_paths), embedding.directory(paths))
        storage.record_index_artifacts(paths, "embeddings", set())
        embedding.install()
        mcp_registration.install()
        # Stage the exact shipped skill in the disposable home. The normal
        # installer rejects a second user installation on an installed machine.
        skill = codex / "skills/base-layer-context/SKILL.md"
        skill.parent.mkdir(parents=True, mode=0o700)
        skill.write_text(codex_skills.source())
        codex_hooks.install()
        manifest = storage.read_manifest(paths)
        socket = root.name
        os.environ["RECALL_DEMO_SOCKET"] = socket
        os.environ.setdefault("GIF_FPS", "3")
        os.environ["PS1"] = "> "

        with (root / "daemon.log").open("w") as log:
            daemon = subprocess.Popen(
                [manifest["interpreter"], "-m", "bl_context.daemon",
                 "--installation-id", manifest["installation_id"]],
                stdout=log, stderr=log,
            )
            try:
                deadline = time.monotonic() + 20
                while not storage.socket_path(paths).exists():
                    if daemon.poll() is not None or time.monotonic() > deadline:
                        raise RuntimeError("Demo daemon did not start")
                    time.sleep(0.1)
                tmux(socket, "-f", str(repo / "assets/recall.tmux.conf"),
                     "new-session", "-d", "-s", "recall", "-x", "150", "-y", "35",
                     "-c", str(project), shell)
                tmux(socket, "select-pane", "-t", "recall:0.0", "-T", "SESSION 1 · TELL CODEX")
                tmux(socket, "split-window", "-h", "-t", "recall:0",
                     "-c", str(project), shell)
                tmux(socket, "select-pane", "-t", "recall:0.1", "-T", "FRESH SESSION · ASK AGAIN")
                tmux(socket, "select-pane", "-t", "recall:0.0")
                subprocess.run([str(repo / "assets/make-demo-gif"), "recall"], cwd=repo, check=True)
            finally:
                subprocess.run(["tmux", "-L", socket, "kill-server"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                daemon.terminate()
                try:
                    daemon.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    daemon.kill()
                    daemon.wait()


if __name__ == "__main__":
    main()
